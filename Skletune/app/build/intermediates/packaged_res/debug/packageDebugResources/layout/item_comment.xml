<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_comment_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_alumno"
        android:scaleType="centerCrop"
        android:layout_marginStart="16dp"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/text_comment_user"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:textColor="#000000"
        app:layout_constraintStart_toEndOf="@id/image_comment_avatar"
        app:layout_constraintTop_toTopOf="@id/image_comment_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="María López" />

    <TextView
        android:id="@+id/text_comment_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="2dp"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@id/text_comment_user"
        app:layout_constraintStart_toEndOf="@id/image_comment_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="¡Me encanta esta foto! Está increíble 🔥🔥" />

    <TextView
        android:id="@+id/text_comment_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toEndOf="@id/image_comment_avatar"
        app:layout_constraintTop_toBottomOf="@id/text_comment_body"
        tools:text="Hace 1 h" />

</androidx.constraintlayout.widget.ConstraintLayout>