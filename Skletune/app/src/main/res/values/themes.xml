<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema Base de la Aplicación (Sin Barra de Acción) -->
    <style name="Base.Theme.Skletune" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Atributos base que pueden ser heredados -->
    </style>

    <!-- Tema Principal de la Aplicación (Corregido para no tener Barra de Acción) -->
    <style name="Theme.Skeletune" parent="Base.Theme.Skletune">
        <!-- Color primario -->
        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryVariant">#121212</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Color de fondo de la ventana -->
        <item name="android:windowBackground">#000000</item>
    </style>

    <!-- Estilos de texto específicos -->
    <style name="keletun">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="crea_una_cu">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="ingresa_tu_">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="TituloSeccion">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#1A1A1A</item>
    </style>

    <!-- Tema para el Minijuego OSU (Sin Barra de Acción) -->
    <style name="Base.Theme.OSU" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_cyan_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_gold</item>
        <item name="colorSecondaryVariant">@color/accent_gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.OSU" parent="Base.Theme.OSU" />

    <!-- Estilos para la pantalla de resultados -->
    <style name="ResultLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="ResultValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Estilos para la Tarjeta de Estadísticas -->
    <style name="EstadisticaIcono">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">24sp</item>
        <item name="android:layout_rowSpan">2</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginEnd">12dp</item>
    </style>

    <style name="EstadisticaValor">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="EstadisticaLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#757575</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>